# Token e Client ID do Bot do Discord
DISCORD_TOKEN=
CLIENT_ID=

# IDs das Guildas (Servidores) para sincronização instantânea (separe por vírgula para múltiplos)
GUILD_ID=

# Token pessoal do GitHub (Opcional - para evitar limites de taxa na API do GitHub ao monitorar repositórios)
GITHUB_TOKEN=

# Conexão do PostgreSQL (Credenciais para construir a DATABASE_URL)
DB_HOST=p2.hcraft.online
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=ro8765post
DB_NAME=szl_bot_db
DB_SCHEMA=public

# Se preferir usar DATABASE_URL diretamente, preencha abaixo (sobrescreve as variáveis DB_* acima)
# DATABASE_URL="postgresql://postgres:senha@localhost:5432/szl_bot_db?schema=public"

# Porta onde o Dashboard rodará (Padrão: 9180 para não conflitar com odin-bot)
PORT=9180

# Configurações de Segurança e Login via Discord (OAuth2)
CLIENT_SECRET=
REDIRECT_URI=http://localhost:9180/api/auth/callback
SESSION_SECRET=szl-bot-secure-session-key-9821
ADMIN_IDS=

